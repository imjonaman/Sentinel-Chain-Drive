# Sentinel Chain Drive - Environment Configuration Template
# Copy this file to .env for local development:
#   cp .env.example .env
# IMPORTANT: Never commit actual passwords, private keys, or tokens to version control.

# Application Environment
ENVIRONMENT=development
DEBUG=false
APP_NAME="Sentinel Chain Drive"
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000

# Security & CORS
# JSON list of allowed origins (Conservative: localhost and loopback only for local development)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]
# Maximum request body size in bytes (e.g. 1048576 = 1MB)
MAX_REQUEST_SIZE_BYTES=1048576

# Structured Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# ==============================================================================
# Database Configuration Options
# ==============================================================================

# OPTION A: Local PostgreSQL (Default)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentinel_chain_drive
POSTGRES_USER=sentinel_user
POSTGRES_PASSWORD=replace_with_secure_local_dev_password
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
POSTGRES_POOL_TIMEOUT_SECONDS=30

# OPTION B: SQLite (Zero external dependencies for rapid local evaluation)
# DATABASE_URL=sqlite+aiosqlite:///./sentinel.db

# OPTION C: Supabase PostgreSQL
# Note: Supabase provides two connection types in Project Settings -> Database:
#
# 1. Direct Connection (Port 5432 - IPv6/IPv4 direct, required for Alembic migrations):
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?ssl=require
#
# 2. Connection Pooler / Supavisor (Port 6543 - Transaction mode for high-concurrency API workloads):
# DATABASE_URL=postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?ssl=require
#
# When using Supabase Transaction Pooler (port 6543):
# - Set POSTGRES_STATEMENT_CACHE_SIZE=0 (disables prepared statements unsupported by transaction poolers)
# - Optionally set POSTGRES_USE_NULL_POOL=true (disables client-side pooling to avoid holding idle pooler connections)
# - Set ALEMBIC_DATABASE_URL to the direct port 5432 connection so migrations run with transactional DDL session support:
# ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# POSTGRES_STATEMENT_CACHE_SIZE=0
# POSTGRES_USE_NULL_POOL=false

# DRUNIX Ledger Integration Interface (Placeholder/Mock Adapter for Phase 1)
DRUNIX_ADAPTER_TYPE=mock
DRUNIX_ENDPOINT_URL=http://localhost:9000
