# Sentinel Chain Drive - Environment Configuration Template
# Copy this file to .env for local development:
#   cp .env.example .env
# IMPORTANT: Never commit actual passwords, private keys, or tokens to version control.

# Application Environment
ENVIRONMENT=development
DEBUG=false
APP_NAME="Sentinel Chain Drive"
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000

# Security & CORS
# JSON list of allowed origins (Conservative: localhost and loopback only for local development)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]
# Maximum request body size in bytes (e.g. 1048576 = 1MB)
MAX_REQUEST_SIZE_BYTES=1048576

# Structured Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentinel_chain_drive
POSTGRES_USER=sentinel_user
POSTGRES_PASSWORD=replace_with_secure_local_dev_password
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
POSTGRES_POOL_TIMEOUT_SECONDS=30

# Async Database URL (auto-assembled from POSTGRES_* or overridden directly)
# DATABASE_URL=postgresql+asyncpg://sentinel_user:replace_with_secure_local_dev_password@localhost:5432/sentinel_chain_drive

# DRUNIX Ledger Integration Interface (Placeholder/Mock Adapter for Phase 1)
DRUNIX_ADAPTER_TYPE=mock
DRUNIX_ENDPOINT_URL=http://localhost:9000
